		touch-action \none
		overscroll-behavior \none
	-
	event *
		^
		pointerdown?event <=> event_start?event null
		pointermove?event <=> event_move?event null
		pointerup?event <=> event_end?event null
		pointerleave?event <=> event_leave?event null
		wheel?event <=> event_wheel?event null

$mol_plot_pane $mol_svg_root
	aspect \none
	-
	hue_base? +NaN
	hue_shift? 111
	-
	gap_hor 48
	gap_vert 24
	gap_left <= gap_hor
	gap_right <= gap_hor
	gap_top <= gap_vert
	gap_bottom <= gap_vert
	gap $mol_vector_2d<$mol_vector_range<number>> /
		<= gap_x $mol_vector_range<number> /
			<= gap_left
			<= gap_right
		<= gap_y $mol_vector_range<number> /
			<= gap_bottom
			<= gap_top
	-
	shift_limit $mol_vector_2d<$mol_vector_range<number>> /
		<= shift_limit_x $mol_vector_range<number> /
			0
			0
		<= shift_limit_y $mol_vector_range<number> /
			0
			0
	shift_default $mol_vector_2d<number> /
		0
		0
	shift? $mol_vector_2d<number> /
		0
		0
	scale_limit $mol_vector_2d<$mol_vector_range<number>> /
		<= scale_limit_x $mol_vector_range<number> /
			0
			Infinity
		<= scale_limit_y $mol_vector_range<number> /
			0
			-Infinity
	scale_default $mol_vector_2d<number> /
		0
		0
	scale? $mol_vector_2d<number> /
		1
		-1
	scale_x? 1
	scale_y? -1
	size $mol_vector_2d<number> /
		0
		0
	size_real $mol_vector_2d<number> /
		1
		1
	dimensions $mol_vector_2d<$mol_vector_range<number>> /
		<= dimensions_x $mol_vector_range<number> /
			Infinity
			-Infinity
		<= dimensions_y $mol_vector_range<number> /
			Infinity
			-Infinity
	dimensions_viewport $mol_vector_2d<$mol_vector_range<number>> /
		<= dimensions_viewport_x $mol_vector_range<number> /
			Infinity
			-Infinity
		<= dimensions_viewport_y $mol_vector_range<number> /
			Infinity
			-Infinity
	-
	sub <= graphs_sorted /$mol_svg
	graphs_colored <= graphs_visible <= graphs_positioned <= graphs /$mol_plot_graph
	-
	plugins /
		^
		<= Touch $mol_touch
			zoom? <=> zoom? 1
			pan? <=> shift?
			pointer_center => cursor_position
			allow_draw <= allow_draw true
			allow_pan <= allow_pan true
			allow_zoom <= allow_zoom true
			action_type => action_type
			action_point => action_point
			draw_start?event <=> draw_start?event null
			draw?event <=> draw?event null
			draw_end?event <=> draw_end?event null
	- event *
		^
		dblclick?event <=> reset?event null

$mol_chart $mol_view
	gap_hor 48
	gap_vert 24
	gap_left <= gap_hor
	gap_right <= gap_hor
	gap_bottom <= gap_vert
	gap_top <= gap_vert
	graphs /$mol_plot_graph
	sub /
		<= Legend $mol_chart_legend
			graphs <= graphs_colored
		<= Plot $mol_plot_pane
			scale_x? => zoom?
			zoom? <=> zoom?
			gap_left <= gap_left
			gap_right <= gap_right
			gap_bottom <= gap_bottom
			gap_top <= gap_top
			graphs <= graphs
			graphs_colored => graphs_colored
			hue_base <= hue_base 210
			hue_shift <= hue_shift 163

$mol_section $mol_list
	level 1
	rows /
		<= Head $mol_view
			sub <= head /
				<= Title $mol_view
					dom_name <= title_dom_name \h1
					sub / <= title
				<= Tools $mol_view sub <= tools /
		<= Content $mol_list
			rows <= content /

$bog_metrics_dashboard_overview $mol_page
	title \Overview
	Head null
	all_events /
	body /
		<= Stats $mol_row
			sub /
				<= Dau_card $bog_metrics_dashboard_stat_card
					title \DAU
					value <= dau \0
				<= Pageviews_card $bog_metrics_dashboard_stat_card
					title \Pageviews today
					value <= pageviews_today \0
				<= Sessions_card $bog_metrics_dashboard_stat_card
					title \Sessions today
					value <= sessions_today \0
		<= Chart_section $mol_section
			title \Pageviews by day
			content /
				<= Chart $mol_chart
					graphs /
						<= Pageviews_bar $mol_plot_bar
							title \Pageviews
							series_y <= chart_pageviews_y /number
						<= Day_labels $mol_plot_mark_hor
							title \Day
							labels <= chart_day_labels /string
						<= Count_axis $mol_plot_ruler_vert
							title \Count
		<= Top_pages_section $mol_section
			title \Top pages
			content <= top_pages_rows /
				<= Top_page_row*0 $mol_row
					sub /
						<= Top_page_url* \
						<= Top_page_count* \
		<= Top_referrers_section $mol_section
			title \Top referrers
			content <= top_referrers_rows /
				<= Top_referrer_row*0 $mol_row
					sub /
						<= Top_referrer_url* \
						<= Top_referrer_count* \

$bog_metrics_dashboard_stat_card $mol_view
	title \
	value \0
	sub /
		<= Value $mol_paragraph
			title <= value
		<= Title $mol_paragraph
			title <= title

$bog_metrics_dashboard_sessions $mol_page
	title \Sessions
	Head null
	all_events /
	body /
		<= Summary $mol_row
			sub /
				<= Total_card $bog_metrics_dashboard_stat_card
					title \Total sessions
					value <= total_sessions \0
				<= Avg_duration_card $bog_metrics_dashboard_stat_card
					title \Avg duration
					value <= avg_duration \—
				<= Avg_pages_card $bog_metrics_dashboard_stat_card
					title \Avg pages
					value <= avg_pages \0
		<= Sessions_list $mol_section
			title \Recent sessions
			content <= session_rows /
				<= Session_row*0 $mol_row
					sub /
						<= Session_uid* $mol_paragraph
							title <= session_uid* \
						<= Session_duration* $mol_paragraph
							title <= session_duration* \
						<= Session_pages* $mol_paragraph
							title <= session_pages* \
						<= Session_time* $mol_paragraph
							title <= session_time* \

$mol_plot_line $mol_plot_graph
	threshold 1
	spacing 2
	color_fill \none
	dom_name \path
	attr *
		^
		d <= curve \
	sub /
		<= Hint
	-
	Sample $mol_plot_graph_sample
		color <= color
		type <= type

$bog_metrics_dashboard_vitals $mol_page
	title \Vitals
	Head null
	all_events /
	body /
		<= Summary $mol_row
			sub /
				<= Lcp_card $bog_metrics_dashboard_stat_card
					title \LCP p75
					value <= lcp_p75 \—
				<= Inp_card $bog_metrics_dashboard_stat_card
					title \INP p75
					value <= inp_p75 \—
				<= Cls_card $bog_metrics_dashboard_stat_card
					title \CLS p75
					value <= cls_p75 \—
		<= Chart_section $mol_section
			title \LCP over time
			content /
				<= Chart $mol_chart
					graphs /
						<= Lcp_line $mol_plot_line
							title \LCP (ms)
							series_y <= chart_lcp_y /number
						<= Time_labels $mol_plot_mark_hor
							title \Time
							labels <= chart_time_labels /string
						<= Value_axis $mol_plot_ruler_vert
							title \ms
		<= Vitals_list $mol_section
			title \Recent vitals
			content <= vital_rows /
				<= Vital_row*0 $mol_row
					sub /
						<= Vital_name* $mol_paragraph
							title <= vital_name* \
						<= Vital_value* $mol_paragraph
							title <= vital_value* \
						<= Vital_time* $mol_paragraph
							title <= vital_time* \

$bog_metrics_dashboard_errors $mol_page
	title \Errors
	Head null
	all_events /
	body /
		<= Summary $mol_row
			sub /
				<= Total_card $bog_metrics_dashboard_stat_card
					title \Total errors
					value <= total_errors \0
				<= Unique_card $bog_metrics_dashboard_stat_card
					title \Unique errors
					value <= unique_errors \0
		<= Errors_list $mol_section
			title \Errors by message
			content <= error_rows /
				<= Error_row*0 $mol_section
					title <= error_message* \
					content /
						<= Error_details*0 $mol_row
							sub /
								<= Error_count* $mol_paragraph
									title <= error_count* \
								<= Error_last_seen* $mol_paragraph
									title <= error_last_seen* \
