$bog_metrics_dashboard_overview $mol_page
	title \Overview
	Head null
	all_events /
	body /
		<= Stats $mol_row
			sub /
				<= Dau_card $bog_metrics_dashboard_stat_card
					title \DAU
					value <= dau \0
				<= Pageviews_card $bog_metrics_dashboard_stat_card
					title \Pageviews today
					value <= pageviews_today \0
				<= Sessions_card $bog_metrics_dashboard_stat_card
					title \Sessions today
					value <= sessions_today \0
		<= Chart_section $mol_section
			title \Pageviews by day
			content /
				<= Chart $mol_chart
					graphs /
						<= Pageviews_bar $mol_plot_bar
							title \Pageviews
							series_y <= chart_pageviews_y /number
						<= Day_labels $mol_plot_mark_hor
							title \Day
							labels <= chart_day_labels /string
						<= Count_axis $mol_plot_ruler_vert
							title \Count
		<= Top_pages_section $mol_section
			title \Top pages
			content <= top_pages_rows /
				<= Top_page_row*0 $mol_row
					sub /
						<= Top_page_url* \
						<= Top_page_count* \
		<= Top_referrers_section $mol_section
			title \Top referrers
			content <= top_referrers_rows /
				<= Top_referrer_row*0 $mol_row
					sub /
						<= Top_referrer_url* \
						<= Top_referrer_count* \

$bog_metrics_dashboard_stat_card $mol_view
	title \
	value \0
	sub /
		<= Value $mol_paragraph
			title <= value
		<= Title $mol_paragraph
			title <= title
